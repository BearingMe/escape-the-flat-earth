; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Flat Earth Survivor"
run/main_scene="res://levels/flat_earth/world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/flush_stdout_on_print=true
config/icon="res://icon.svg"

[autoload]

Log="*res://autoload/log.gd"
World="*res://autoload/world.gd"
Net="*res://autoload/net.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Flat Earth Survivor"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/gut/plugin.cfg")

[physics]

3d/default_gravity=0.0
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
